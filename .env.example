# Server Environment Variables
PORT=5000
NODE_ENV=development
JWT_SECRET=documind_production_jwt_secret_key_2026_secure
JWT_EXPIRES_IN=7d

# Database (Leave empty to use built-in zero-config disk persisted database)
MONGODB_URI=

# AI Provider (Optional: Set Gemini or OpenAI API Key for live external models,
# or leave blank to use DocuMind's built-in hybrid RAG & deterministic reasoning engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage Provider (local | s3 | r2 | cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Client URL
CLIENT_URL=http://localhost:5173
